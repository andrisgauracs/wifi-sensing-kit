diff --git a/firmware/esp32-csi-node/main/csi_collector.c b/firmware/esp32-csi-node/main/csi_collector.c
index 6a15443..d4d4493 100644
--- a/firmware/esp32-csi-node/main/csi_collector.c
+++ b/firmware/esp32-csi-node/main/csi_collector.c
@@ -43,6 +43,23 @@ static bool s_node_id_early_set = false;
  * corrupts g_nvs_config, the callback would read garbage, potentially causing
  * LoadProhibited panics (observed: Core 0 panic after ~2400 callbacks). */
 static uint8_t s_filter_mac[6] = {0};
+
+/* wifi-sensing-kit: board-to-board links.
+ * Only frames sent by the home router or by one of the three sensing boards are kept, so the
+ * ~50 Hz CSI budget isn't spent on neighbours' traffic. Each kept frame is tagged with its
+ * sender: byte 19 bit 7 set => 6-byte transmitter MAC appended after the I/Q data. */
+#define LINK_TX_MAC_FLAG 0x80
+/* kit_config.h is generated by wifi-sensing-kit firmware/build.py from config.yaml:
+ *   LINK_MACS = router BSSID + every board's MAC */
+#include "kit_config.h"
+static const uint8_t k_link_macs[][6] = LINK_MACS;
+static bool link_mac_allowed(const uint8_t *mac)
+{
+    for (size_t i = 0; i < sizeof(k_link_macs) / sizeof(k_link_macs[0]); i++) {
+        if (memcmp(mac, k_link_macs[i], 6) == 0) return true;
+    }
+    return false;
+}
 static bool    s_filter_mac_set = false;
 
 /* ADR-057: Build-time guard — fail early if CSI is not enabled in sdkconfig.
@@ -158,7 +175,7 @@ size_t csi_serialize_frame(const wifi_csi_info_t *info, uint8_t *buf, size_t buf
     uint16_t iq_len = (uint16_t)info->len;
     uint16_t n_subcarriers = iq_len / (2 * n_antennas);
 
-    size_t frame_size = CSI_HEADER_SIZE + iq_len;
+    size_t frame_size = CSI_HEADER_SIZE + iq_len + 6;   /* + transmitter MAC (local change) */
     if (frame_size > buf_len) {
         ESP_LOGW(TAG, "Buffer too small: need %u, have %u", (unsigned)frame_size, (unsigned)buf_len);
         return 0;
@@ -266,6 +283,10 @@ size_t csi_serialize_frame(const wifi_csi_info_t *info, uint8_t *buf, size_t buf
     /* I/Q data */
     memcpy(&buf[CSI_HEADER_SIZE], info->buf, iq_len);
 
+    /* Local change: transmitter MAC after the I/Q data, flagged in byte 19 bit 7 */
+    memcpy(&buf[CSI_HEADER_SIZE + iq_len], info->mac, 6);
+    buf[19] |= LINK_TX_MAC_FLAG;
+
     return frame_size;
 }
 
@@ -276,6 +297,11 @@ static void wifi_csi_callback(void *ctx, wifi_csi_info_t *info)
 {
     (void)ctx;
 
+    /* Local change: keep only router + sensing-board frames (cheap memcmp, before the rate gate) */
+    if (info == NULL || !link_mac_allowed(info->mac)) {
+        return;
+    }
+
     /* Early rate gate: drop excess callbacks to ~50 Hz to prevent
      * SPI flash cache crash in WiFi ISR (wDev_ProcessFiq). */
     int64_t now_us = esp_timer_get_time();
diff --git a/firmware/esp32-csi-node/main/main.c b/firmware/esp32-csi-node/main/main.c
