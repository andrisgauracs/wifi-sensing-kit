-    led_strip_handle_t led_strip;
-    if (led_strip_new_rmt_device(&strip_config, &rmt_config, &led_strip) == ESP_OK) {
-        led_strip_clear(led_strip);
-        led_strip_del(led_strip);
+    /* wifi-sensing-kit: light the onboard LED in this node's colour (from config.yaml via
+     * kit_config.h: KIT_NODE_RGB = { {node_id, r, g, b}, ... }) instead of clearing it.
+     * Driven on GPIO 48 and, on S3, also GPIO 38: DevKitC-1 revisions wire the WS2812 to either pin. */
+    static const uint8_t node_rgb[][4] = KIT_NODE_RGB;
