+            ESP_LOGI(TAG, "Onboard WS2812 on GPIO %d: node %d colour %d,%d,%d", id_led_pins[i], nid, rgb[0], rgb[1], rgb[2]);
+            /* handle intentionally kept: deleting the RMT device can glitch the line */
+        }
     }
 #endif /* CONFIG_LED_GAMMA_VIZ */
 
